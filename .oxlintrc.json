{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  /*
   * Architectural boundaries are enforced here, not merely documented in the README.
   *
   *   annotationvocabulary  leaf, pure data
   *   ontologymodel         pure; may use annotationvocabulary only
   *   serialization         pure; may use ontologymodel + annotationvocabulary only
   *   search                pure; may use ontologymodel + annotationvocabulary only
   *   designsystem          leaf UI primitives; imports nothing from src/
   *   projectstore          app state; may use ontologymodel + annotationvocabulary
   *   <ui modules>          may use the layers above, never each other
   *   appshell              the single composition point, may import anything
   *
   * `npm run lint` fails if any of these is violated, and tests/lint/boundaries.test.ts proves
   * that it still does.
   *
   * Each module appears twice in an import group, as the folder and as everything inside it:
   * `../projectstore` resolves through the module's index, so the glob for the folder's contents
   * alone does not match it.
   *
   * The rules are listed one by one rather than taken from oxlint's categories. They are exactly
   * what ESLint's and typescript-eslint's recommended sets applied before the move, so switching
   * linters changed the tool and not the policy. Three of those rules have no oxlint equivalent
   * and need none: `no-octal` and `no-dupe-args` are syntax errors in module code, which the
   * parser already rejects, and React's `config` and `gating` rules check settings for the
   * React Compiler, which this project does not use.
   */
  "plugins": ["typescript", "react"],
  "categories": { "correctness": "off" },

  /*
   * Build output and tool scratch space. `.stryker-tmp` is a copy of the whole repository that
   * mutation testing works in, and it is left behind when a run crashes -- linting it would
   * report every finding twice, for whoever last ran `npm run mutation` and for no one else.
   */
  "ignorePatterns": [
    "dist",
    "coverage",
    "playwright-report",
    "test-results",
    "node_modules",
    ".stryker-tmp",
    "mutation"
  ],

